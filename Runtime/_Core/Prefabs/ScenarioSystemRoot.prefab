    - rid: 5767728308294517000
      type: {class: InstructionDataCondition, ns: , asm: PromVR.ScenarioSystem}
      data:
        instructionClip: {fileID: 0}
        instructionText: "\u0414\u043E\u0431\u0440\u043E \u043F\u043E\u0436\u0430\u043B\u043E\u0432\u0430\u0442\u044C
          \u0432 \u0434\u0435\u043C\u043E\u043D\u0441\u0442\u0440\u0430\u0446\u0438\u043E\u043D\u043D\u0443\u044E
          \u0441\u0446\u0435\u043D\u0443 \u0441\u0438\u0441\u0442\u0435\u043C\u044B
          \u0441\u0446\u0435\u043D\u0430\u0440\u0438\u0435\u0432. \u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435
          \u0440\u0435\u0436\u0438\u043C \u0438 \u0441\u0446\u0435\u043D\u0430\u0440\u0438\u0439."
        instructionRepeatDelay: 30
    - rid: 5767728308294517001
      type: {class: InstructionDataCondition, ns: , asm: PromVR.ScenarioSystem}
      data:
        instructionClip: {fileID: 0}
        instructionText: "\u0412\u044B \u0432\u044B\u0431\u0440\u0430\u043B\u0438
          \u0440\u0435\u0436\u0438\u043C \u043E\u0431\u0443\u0447\u0435\u043D\u0438\u044F,
          \u0432 \u0434\u0430\u043D\u043D\u043E\u043C \u0440\u0435\u0436\u0438\u043C\u0435
          \u0431\u0443\u0434\u0435\u0442 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0430
          \u043C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u0430\u044F
          \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u043A\u0430 \u0432\u043E \u0432\u0440\u0435\u043C\u044F
          \u043F\u0440\u043E\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u044F!"
        instructionRepeatDelay: 30
    - rid: 5767728308294517002
      type: {class: InstructionDataCondition, ns: , asm: PromVR.ScenarioSystem}
      data:
        instructionClip: {fileID: 0}
        instructionText: "\u0412\u044B \u0432\u044B\u0431\u0440\u0430\u043B\u0438
          \u0440\u0435\u0436\u0438\u043C \u0442\u0440\u0435\u043D\u0438\u0440\u043E\u0432\u043A\u0438,
          \u0432 \u0434\u0430\u043D\u043D\u043E\u043C \u0440\u0435\u0436\u0438\u043C\u0435
          \u0431\u0443\u0434\u0443\u0442 \u043E\u0442\u043A\u043B\u044E\u0447\u0435\u043D\u044B
          \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0438. \u041F\u0440\u0438
          \u0441\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u0438\u0438 \u043E\u0448\u0438\u0431\u043A\u0438
          \u0431\u0443\u0434\u0435\u0442 \u043F\u0435\u0440\u0435\u0437\u0430\u043F\u0443\u0449\u0435\u043D\u0430
          \u0433\u0440\u0443\u043F\u043F\u0430 \u0448\u0430\u0433\u043E\u0432 \u0438
          \u0440\u0430\u0437\u044A\u044F\u0441\u043D\u0435\u043D\u043E \u0432 \u0447\u0451\u043C
          \u0431\u044B\u043B\u0430 \u0441\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u0430
          \u043E\u0448\u0438\u0431\u043A\u0430."
        instructionRepeatDelay: 30
    - rid: 5767728308294517003
      type: {class: InstructionDataCondition, ns: , asm: PromVR.ScenarioSystem}
      data:
        instructionClip: {fileID: 0}
        instructionText: "\u0412\u044B \u0432\u044B\u0431\u0440\u0430\u043B\u0438
          \u0440\u0435\u0436\u0438\u043C \u044D\u043A\u0437\u0430\u043C\u0435\u043D\u0430,
          \u0432 \u0434\u0430\u043D\u043D\u043E\u043C \u0440\u0435\u0436\u0438\u043C\u0435
